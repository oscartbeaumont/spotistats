{
  "name": "spotistats",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "cf dev",
    "build": "cf workers types && tsc --noEmit && cf build",
    "preview": "cf build && vite preview",
    "deploy": "cf deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cf-typegen": "cf workers types",
    "db:migrate:local": "cf d1 migrations apply 7529dabd-7b6d-42f6-ac94-ddc3db1332ab --local",
    "db:migrate:remote": "cf d1 migrations apply 7529dabd-7b6d-42f6-ac94-ddc3db1332ab"
  },
  "dependencies": {
    "@effect/sql-d1": "^4.0.5",
    "@solidjs/meta": "next",
    "@solidjs/router": "next",
    "@solidjs/web": "next",
    "effect": "^4.0.5",
    "jszip": "^3.10.2",
    "posthog-js": "^1.438.12",
    "solid-js": "next"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "beta",
    "@solidjs/vite-plugin": "3.0.0-next.50",
    "@tailwindcss/vite": "^4.3.3",
    "cf": "1.0.0-beta.19",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
