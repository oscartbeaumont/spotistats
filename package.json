{
  "name": "spotistats",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.1",
  "engines": {
    "node": ">=24"
  },
  "pnpm": {
    "overrides": {
      "seroval": "^1.7.6",
      "seroval-plugins": "^1.7.6"
    }
  },
  "scripts": {
    "dev": "pnpm db:migrate:local && cf dev",
    "build": "cf workers types && tsc --noEmit && cf build",
    "preview": "cf build && vite preview",
    "ship": "cf deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cf-typegen": "cf workers types",
    "db:migrate:local": "cf d1 migrations apply 7529dabd-7b6d-42f6-ac94-ddc3db1332ab --local --persist-to .cloudflare/state",
    "db:migrate:remote": "cf d1 migrations apply 7529dabd-7b6d-42f6-ac94-ddc3db1332ab"
  },
  "dependencies": {
    "@effect/sql-d1": "^4.1.4",
    "@solidjs/meta": "next",
    "@solidjs/router": "next",
    "@solidjs/web": "next",
    "effect": "^4.1.4",
    "jszip": "^3.10.2",
    "posthog-js": "^1.449.1",
    "solid-js": "next"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "beta",
    "@solidjs/vite-plugin": "3.0.0-next.57",
    "@tailwindcss/vite": "^4.3.5",
    "cf": "1.0.0-beta.32",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
