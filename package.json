{
  "name": "spotistats",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "deploy": "pnpm run build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply spotistats --local",
    "db:migrate:remote": "wrangler d1 migrations apply spotistats --remote"
  },
  "dependencies": {
    "@effect/sql-d1": "^4.0.0",
    "@solidjs/meta": "next",
    "@solidjs/router": "next",
    "@solidjs/web": "next",
    "effect": "^4.0.0",
    "jszip": "^3.10.1",
    "posthog-js": "^1.371.2",
    "solid-js": "next"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.33.1",
    "@cloudflare/workers-types": "^4.20260423.1",
    "@solidjs/vite-plugin": "next",
    "@tailwindcss/vite": "^4.2.4",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "wrangler": "^4.84.1"
  }
}
