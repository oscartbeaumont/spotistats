{
  "name": "spotistats",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm db:migrate:local && cf dev",
    "build": "cf workers types && tsc --noEmit && cf build",
    "preview": "cf build && vite preview",
    "ship": "cf deploy",
    "typecheck": "tsc --noEmit",
    "prelint": "cf workers types",
    "lint": "effect-tsgo oxlint --deny-warnings",
    "lint:fix": "effect-tsgo oxlint --fix",
    "test": "vitest run",
    "cf-typegen": "cf workers types",
    "db:migrate:local": "cf d1 migrations apply 7529dabd-7b6d-42f6-ac94-ddc3db1332ab --local --persist-to .cloudflare/state",
    "db:migrate:remote": "cf d1 migrations apply 7529dabd-7b6d-42f6-ac94-ddc3db1332ab"
  },
  "dependencies": {
    "@effect/sql-d1": "^4.1.4",
    "@solidjs/meta": "2.0.0",
    "@solidjs/router": "2.0.0",
    "@solidjs/web": "2.0.0",
    "effect": "^4.1.4",
    "jszip": "^3.10.2",
    "posthog-js": "^1.450.1",
    "solid-js": "2.0.0"
  },
  "devDependencies": {
    "@cloudflare/oxlint-config": "0.1.0",
    "@cloudflare/vite-plugin": "2.0.0-rc.0",
    "@effect/tsgo": "0.73.2",
    "@solidjs/vite-plugin": "3.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "cf": "1.0.0-rc.1",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
