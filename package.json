{
  "name": "spotistats",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "wrangler types && tsc --noEmit && vite build",
    "preview": "pnpm run build && vite preview",
    "deploy": "pnpm run build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cf-typegen": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply spotistats --local",
    "db:migrate:remote": "wrangler d1 migrations apply spotistats --remote"
  },
  "dependencies": {
    "@effect/sql-d1": "^4.0.5",
    "@solidjs/meta": "next",
    "@solidjs/router": "next",
    "@solidjs/web": "next",
    "effect": "^4.0.5",
    "jszip": "^3.10.2",
    "posthog-js": "^1.438.12",
    "solid-js": "next"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/workers-types": "^5.20261019.1",
    "@solidjs/vite-plugin": "next",
    "@tailwindcss/vite": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.2"
  }
}
